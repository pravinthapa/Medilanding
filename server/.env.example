PORT=5000
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/medilanding
# MongoDB Atlas (replace user, password, cluster host):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/medilanding?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin seed credentials
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=admin123

# Allow new admin sign-up at /admin/register (also allowed when no admins exist yet)
ALLOW_ADMIN_REGISTER=true

# Google OAuth (same Client ID for server + client)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Nodemailer (use Gmail App Password or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_NOTIFY_EMAIL=admin@clinic.com
CLINIC_NAME=MediCare Clinic

# Client URL for CORS
CLIENT_URL=http://localhost:5173
